#!/usr/bin/env bash
#
# sparse — manage sparse-checkout of Semantic/<Module> trees.
#
# Usage:
#   scripts/sparse do   <Module>    Add <Module> to the sparse worktree. Cumulative:
#                                    repeated calls bring in more modules. If the
#                                    worktree is currently full, this starts
#                                    sparse-checkout.
#   scripts/sparse undo <Module>    Drop <Module> from the sparse worktree. If it was
#                                    the last module, restore the full worktree.
#   scripts/sparse reset            Restore the full worktree.
#   scripts/sparse list             Show which modules are currently checked out.
#
# A "module" M corresponds to Semantic/M.lean and the Semantic/M/ directory.
#
set -euo pipefail

# Module-independent paths that are always present while in sparse mode:
# build infrastructure, the shared Prelude, plus the scripts and notes trees.
BASE_PATTERNS=(
  /.gitignore
  /.github/
  /lakefile.toml
  /lake-manifest.json
  /lean-toolchain
  /CLAUDE.md
  /AGENTS.md
  /GEMINI.md
  /README.md
  /opencode.json
  /.agents/
  /scripts/
  /notes/
  /roadmaps/
  /Semantic/Prelude.lean
)

die() { echo "sparse: $*" >&2; exit 1; }

# Operate from the repo root so paths are stable regardless of cwd.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
cd "$ROOT"

is_sparse() {
  [ "$(git config --bool core.sparseCheckout 2>/dev/null || echo false)" = "true" ]
}

# Print the currently selected modules (one per line), derived from the live
# sparse-checkout spec. Module entries are the /Semantic/<M>/ directory lines;
# /Semantic/Prelude.lean is a base file and is naturally excluded.
current_modules() {
  is_sparse || return 0
  git sparse-checkout list 2>/dev/null \
    | sed -n 's#^/Semantic/\(.*\)/$#\1#p' \
    | sort -u
}

module_exists() {
  git cat-file -e "HEAD:Semantic/$1.lean" 2>/dev/null
}

# Rewrite the sparse-checkout spec from BASE_PATTERNS plus the given modules
# (passed as arguments). Initializes sparse-checkout if the worktree is full.
apply_modules() {
  local patterns m
  patterns=("${BASE_PATTERNS[@]}")
  for m in "$@"; do
    patterns+=("/Semantic/$m.lean" "/Semantic/$m/")
  done
  git sparse-checkout set --no-cone "${patterns[@]}"
}

cmd=${1:-}
case "$cmd" in
  do)
    [ $# -eq 2 ] || die "usage: sparse do <Module>"
    mod=$2
    module_exists "$mod" || die "no such module: Semantic/$mod.lean not found in HEAD"
    # Union of the current modules and the new one (deduplicated, sorted).
    mods=$( { current_modules; echo "$mod"; } | grep -v '^$' | sort -u )
    apply_modules $mods
    echo "sparse: checked out: $(echo $mods | tr '\n' ' ')"
    ;;
  undo)
    [ $# -eq 2 ] || die "usage: sparse undo <Module>"
    mod=$2
    is_sparse || die "worktree is already full; nothing to undo"
    cur=$(current_modules)
    printf '%s\n' "$cur" | grep -qx "$mod" || die "module not checked out: $mod"
    remaining=$(printf '%s\n' "$cur" | grep -vx "$mod" | grep -v '^$' || true)
    if [ -z "$remaining" ]; then
      git sparse-checkout disable
      echo "sparse: dropped $mod; last module removed, restored full worktree"
    else
      apply_modules $remaining
      echo "sparse: dropped $mod; remaining: $(echo $remaining | tr '\n' ' ')"
    fi
    ;;
  reset)
    [ $# -eq 1 ] || die "usage: sparse reset"
    if is_sparse; then
      git sparse-checkout disable
      echo "sparse: restored full worktree"
    else
      echo "sparse: worktree already full"
    fi
    ;;
  list)
    [ $# -eq 1 ] || die "usage: sparse list"
    if is_sparse; then
      mods=$(current_modules)
      if [ -n "$mods" ]; then
        echo "sparse: checked out modules:"
        printf '  %s\n' $mods
      else
        echo "sparse: sparse-checkout enabled, no Semantic modules selected"
      fi
    else
      echo "sparse: full worktree"
    fi
    ;;
  ""|-h|--help|help)
    sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    die "unknown command: $cmd (try: do, undo, reset, list)"
    ;;
esac
